# Normalise line endings; shell/JS/Python must stay LF so they run on any OS
* text=auto
*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.srt  text eol=lf

# Final video: stored with Git LFS, same as flightdeals-ad-studio
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Other binaries (small, kept in normal Git)
*.png  binary
*.jpg  binary
*.mp3  binary
*.wav  binary
